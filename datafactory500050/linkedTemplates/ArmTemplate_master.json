{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "datafactory500050"
		},
		"csvpoolsynapse_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'csvpoolsynapse'"
		},
		"datalake500040_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'datalake500040'"
		},
		"csvpoolsynapse_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "dataworkspace5000.sql.azuresynapse.net"
		},
		"csvpoolsynapse_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqlpool"
		},
		"csvpoolsynapse_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladminuser"
		},
		"datalake500040_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://datalake500040.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "datafactory500050_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"csvpoolsynapse_password": {
						"value": "[parameters('csvpoolsynapse_password')]"
					},
					"datalake500040_accountKey": {
						"value": "[parameters('datalake500040_accountKey')]"
					},
					"csvpoolsynapse_properties_typeProperties_server": {
						"value": "[parameters('csvpoolsynapse_properties_typeProperties_server')]"
					},
					"csvpoolsynapse_properties_typeProperties_database": {
						"value": "[parameters('csvpoolsynapse_properties_typeProperties_database')]"
					},
					"csvpoolsynapse_properties_typeProperties_userName": {
						"value": "[parameters('csvpoolsynapse_properties_typeProperties_userName')]"
					},
					"datalake500040_properties_typeProperties_url": {
						"value": "[parameters('datalake500040_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}